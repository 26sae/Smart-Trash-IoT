{
	"flutter": {
		"platforms": {
			"dart": {
				"lib/firebase_options.dart": {
					"projectId": "smart-trash23",
					"configurations": {
						"android": "1:596213234164:android:a08c30cd80319a137ce1a1"
					}
				}
			},
			"android": {
				"default": {
					"projectId": "smart-trash23",
					"appId": "1:596213234164:android:a08c30cd80319a137ce1a1",
					"fileOutput": "android/app/google-services.json"
				}
			}
		}
	},
	"hosting": {
		"public": "build/web",
		"headers": [
			{
				"source": "/index.html",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			},
			{
				"source": "/flutter_bootstrap.js",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			},
			{
				"source": "/flutter_service_worker.js",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			}
		],
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	}
}